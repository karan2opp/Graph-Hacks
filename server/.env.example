# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Sessions ---
# Days a sign-in lasts.
SESSION_TTL_DAYS=14
# lax when the client is served from the same site as the API (or through a proxy/rewrite);
# none when they are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax

# --- Demo data (npm run seed) ---
SEED_PASSWORD=

# --- FalkorDB (docker compose up -d) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=court_memory

# --- ImageKit (images, videos, PDFs) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_FOLDER=/court-memory

# --- OpenAI (claim extraction + embeddings) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
