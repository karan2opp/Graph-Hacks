# Leave empty in dev (Vite proxies /api to localhost:5000).
# Set to the deployed API origin in production, e.g. https://court-memory-api.onrender.com
VITE_API_URL=

# Public address of the site, e.g. https://casememory.example.com (used at build time).
# With it, the build writes sitemap.xml and points robots.txt at it; without it, only robots.txt.
SITE_URL=

# Optional: show a "Use the demo account" button on the sign-in page (matches `npm run seed`).
# VITE_DEMO_EMAIL=demo@casememory.test
# VITE_DEMO_PASSWORD=casememory-demo-2026
